# Copy this file to .env (already gitignored) and fill in real values.
# Never commit .env or paste these values into chat/commits.

# --- Supabase (Project Settings -> API) ---
# Safe to expose in browser code (protected by Row-Level Security policies).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Secret. Server-side only (Vercel serverless functions) — bypasses RLS, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (R2 -> Manage API Tokens) ---
# Secret. Used server-side only, to generate presigned upload URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pisa-hub-images
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# Public base URL images are served from (custom domain if you connected one, otherwise the r2.dev URL).
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
